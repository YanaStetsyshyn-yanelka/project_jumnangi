# ===========================================
# SAVE RESULT TO FILE
# ===========================================

def save_result(state, result_text):
    with open("results.txt", "a", encoding="utf-8") as f:
        f.write(
            f"Гравець: {state['name']} | Клас: {state['hero_class']} | "
            f"HP: {state['hp']} | Гроші: {state['money']} | Результат: {result_text}\n"
        )

# ===========================================
# MAIN
# ===========================================

def main():
    state = create_state()

    start_game(state)
    choose_class(state)

    forest(state)

    if state["hp"] > 0:
        desert(state)

    if state["hp"] > 0:
        mountains(state)

    if state["hp"] > 0:
        volcano(state)

    if state["hp"] > 0:
        if final_boss(state):
            result = temple(state)
            save_result(state, result)
        else:
            save_result(state, "Поразка від фінального боса")
    else:
        save_result(state, "Загинув до фінального боса")


main()
