import random

RIDDLES = [
    {"question": "Що можна побачити з заплющеними очима?", "answer": "сон"},
    {"question": "Що завжди збільшується, але ніколи не зменшується?", "answer": "час"},
    {"question": "Що має багато ключів, але не може відкрити жодних дверей?", "answer": "піаніно"},
    {"question": "Чим більше з неї береш, тим більшою вона стає?", "answer": "яма"},
]


def create_state():
    return {
        "name": "",
        "hero_class": "",
        "hp": 0,
        "attack": 0,
        "fear": "",
        "money": 0,
        "inventory": [],
        "forest_money": False,
        "desert_complete": False,
        "mountain_complete": False,
        "have_key": False,
        "volcano_complete": False,
        "armor": False,
        "weapon": False,
    }


def show_past_games():
    try:
        with open("results.txt", "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return

    if not lines:
        return

    YELLOW = "\033[33m"
    RESET = "\033[0m"

    print(f"{YELLOW}=== Історія минулих пригод ==={RESET}")
    for line in lines[-5:]:
        print(line)
    print(f"{YELLOW}==============================={RESET}\n")


def start_game(state):
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

    print(f"""
{RED}{BOLD}
╔══════════════════════════════════════════════╗
║            ЛІС ЗАГУБЛЕНИХ ДУШ               ║
╚══════════════════════════════════════════════╝
{RESET}
""")

    show_past_games()

    print(f"""
{GREEN}Ви прокидаєтесь посеред густого лісу.
Навколо панує моторошна тиша, а між деревами
повільно стелиться холодний туман.{RESET}

{YELLOW}Ви не пам'ятаєте, як тут опинилися...{RESET}

У кишені ви знаходите {GREEN}15${RESET}.

Попереду видніється невеликий табір торговця,
а десь далеко чути дивні звуки.

{RED}Легенди кажуть, що в глибині лісу живе могутній Бос,
який охороняє шлях до свободи.{RESET}

{BOLD}Ваше завдання — вижити та знайти вихід.{RESET}
""")

    state["name"] = input(f"{YELLOW}Як вас звати, мандрівнику?: {RESET}")

    print(f"""
{GREEN}Привіт, {BOLD}{state["name"]}{RESET}{GREEN}!
Удачі, {state["name"]}...{RESET}
""")

    input(f"\n{GREEN}▶️ Натисніть Enter, щоб почати пригоду...{RESET}")


def choose_class(state):
    while True:
        class_choose = input(
            "\033[31mВиберіть Ваш клас:      Медик (Натисніть 1), "
            "Мисливець (Натисніть 2), "
            "Дослідник (Натисніть 3): "
        )

        if class_choose in ['1', '2', '3']:
            break

        print("Невірний вибір. Спробуйте ще раз.")

    if class_choose == "1":
        state["hero_class"] = 'Медик'
        state["hp"] = 150
        state["attack"] = 10
        state["fear"] = 'Паніка'
        state["money"] = 15

    elif class_choose == "2":
        state["hero_class"] = 'Мисливець'
        state["hp"] = 100
        state["attack"] = 25
        state["fear"] = 'Вогонь'
        state["money"] = 15

    elif class_choose == "3":
        state["hero_class"] = 'Дослідник'
        state["hp"] = 90
        state["attack"] = 20
        state["fear"] = 'Спрага'
        state["money"] = 15

    print(f"""
======================================
Ви вибрали клас: {state["hero_class"]}

❤️ Здоров'я: {state["hp"]}
⚔️ Атака: {state["attack"]}
😨 Страх: {state["fear"]}
💰 Кошти: {state["money"]}
======================================
""")


# ===========================================
# LOCATION №1 || FOREST
# ===========================================

def forest(state):
    while True:
        print("""
===========================
           ЛІС
===========================

1. Оглянутись
2. Піти до торговця
3. Продовжити шлях
4. Інвентар

""")
        choice = input("Ваш вибір: ")

        if choice == "1":
            if state["forest_money"] == False:
                if state["hero_class"] == "Дослідник":
                    print("Ви знайшли 20 монет.")
                    state["money"] += 20
                else:
                    print("Ви знайшли 15 монет.")
                    state["money"] += 15
                state["forest_money"] = True
                print("Ваші гроші:", state["money"])
            else:
                print("Ви вже все оглянули.")
        elif choice == "2":
            while True:
                print("""
Торговець:

1. Вода - 5 монет
2. Бинт - 3 монети
3. Вийти
""")
                shop = input("Ваш вибір: ")
                if shop == "1":
                    if state["money"] >= 5:
                        state["money"] -= 5
                        state["inventory"].append("Вода")
                        print("Воду куплено.")
                    else:
                        print("Недостатньо грошей.")
                elif shop == "2":
                    if state["money"] >= 3:
                        state["money"] -= 3
                        state["inventory"].append("Бинт")
                        state["hp"] += 10
                        print("+10 HP")
                    else:
                        print("Недостатньо грошей.")
                elif shop == "3":
                    break
        elif choice == "4":
            print("\nІНВЕНТАР:")
            if len(state["inventory"]) == 0:
                print("Порожньо.")
            else:
                for item in state["inventory"]:
                    print("-", item)
        elif choice == "3":
            print("Ви залишаєте ліс.")
            break
        else:
            print("Невірний вибір.")

# ===========================================
# LOCATION №2 || DESERT
# ===========================================

def desert(state):
    print("""
===========================
          ПУСТЕЛЯ
===========================
""")
    print("Ви входите у гарячу пустелю.")
    print("Сонце виснажує вас.")

    # Особливість Дослідника
    if state["hero_class"] == "Дослідник":
        print("\nВаша перевага допомогла вам.")
        print("Ви витримали спеку.")
    else:
        if "Вода" in state["inventory"]:
            while True:
                use = input("\nУ вас є вода. Використати? (так/ні): ").lower()
                if use == "так":
                    state["inventory"].remove("Вода")
                    print("Ви випили воду.")
                    break
                elif use == "ні":
                    state["hp"] -= 20
                    print("-20 HP")
                    break
                else:
                    print("Введіть так або ні.")
        else:
            state["hp"] -= 20
            print("У вас немає води.")
            print("-20 HP")

    if state["hp"] <= 0:
        print("Ви загинули від спраги.")
        return

    print("""
Перед вами сипучі піски.

1. Перейти прямо
2. Обійти
""")
    while True:
        choice = input("Ваш вибір: ")
        if choice == "1":
            print("Ви потрапили у сипучий пісок.")
            state["hp"] -= 15
            print("-15 HP")
            break
        elif choice == "2":
            print("Ви безпечно обійшли пісок.")
            break
        else:
            print("Невірний вибір.")

    if state["hp"] <= 0:
        print("Ви загинули.")
        return

    print("\nВи знайшли старий мішечок.")
    state["money"] += 10
    print("+10 монет")
    print("Монети:", state["money"])
    state["desert_complete"] = True

# ===========================================
# LOCATION №3 || MOUNTAINS
# ===========================================

def mountains(state):
    print("""
===========================
           ГОРИ
===========================
""")
    while True:
        print("""
Ви знайшли ресурси біля підніжжя гори.

1. Зібрати ягоди (+5 HP)
2. Знайти деревину
3. Йти далі
""")
        choice = input("Ваш вибір: ")
        if choice == "1":
            state["inventory"].append("Ягоди")
            state["hp"] += 5
            print("+5 HP")
        elif choice == "2":
            if "Деревина" not in state["inventory"]:
                state["inventory"].append("Деревина")
                print("Ви знайшли міцну деревину для мосту.")
            else:
                print("Деревина вже у вас.")
        elif choice == "3":
            break
        else:
            print("Невірний вибір.")

    print("\nПеред вами величезна прірва.")
    print("Старий міст зруйнований, тому потрібно обрати шлях.")

    while True:
        print("""
1. Прокласти міст з деревини
2. Обійти гору (-10 HP через втрату енергії)
""")
        bridge = input("Ваш вибір: ")
        if bridge == "1":
            if "Деревина" in state["inventory"]:
                print("Ви проклали міст з деревини та безпечно перейшли прірву.")
                state["inventory"].remove('Деревина')
                break
            else:
                print("У вас немає деревини. Доведеться обійти гору.")
        elif bridge == "2":
            state["hp"] -= 10
            print("Ви обійшли гору, але втратили 10 HP через втрату енергії.")
            print("HP:", state["hp"])
            break
        else:
            print("Невірний вибір.")

    if state["hp"] <= 0:
        print("Ви не витримали виснаження.")
        return

    print("\nНа вершині стоїть мудрець.")
    print("Він може дати ключ, але ви можете йти далі без розмови.")

    while True:
        answer = input("Поговорити з мудрецем? (так/ні): ").lower()
        if answer == "так":
            riddle = random.choice(RIDDLES)
            print("\nМудрець задає загадку:")
            print(riddle["question"])
            reply = input("Відповідь: ").lower()
            if reply == riddle["answer"]:
                print("Мудрець дав вам ключ.")
                if "Ключ" not in state["inventory"]:
                    state["inventory"].append("Ключ")
                state["have_key"] = True
            else:
                print("Мудрець хитає головою. Ключ залишається у нього.")
            break
        elif answer == "ні":
            print("Ви обираєте йти далі без ключа.")
            break
        else:
            print("Невірний вибір.")
    state["mountain_complete"] = True
    print("Ви залишаєте гори.")

# ===========================================
# LOCATION №4 || VOLCANO
# ===========================================

def volcano(state):
    print("""
===========================
          ВУЛКАН
===========================
""")
    print("Перед вами активний вулкан.")
    print("Навколо розпечена лава.")

    # шкода від температури
    damage = 40
    if state["armor"]:
        damage = 20
    state["hp"] -= damage
    print(f"Через спеку ви втратили {damage} HP.")
    print("HP:", state["hp"])

    if state["hp"] <= 0:
        print("Ви не пережили спеку.")
        return

    # Торговець №2
    while True:
        print("""
ТОРГОВЕЦЬ:

1. Зброя (+15 ATK) - 15 монет
2. Бронежилет - 15 монет
3. Продовжити
""")
        choice = input("Ваш вибір: ")

        if choice == "1":
            if state["weapon"]:
                print("У вас вже є зброя.")
            elif state["money"] >= 15:
                state["money"] -= 15
                state["attack"] += 15
                state["weapon"] = True
                state["inventory"].append("Зброя")
                print("Ви купили зброю.")
                print("АТК:", state["attack"])
            else:
                print("Недостатньо грошей.")
        elif choice == "2":
            if state["armor"]:
                print("У вас вже є броня.")
            elif state["money"] >= 15:
                state["money"] -= 15
                state["armor"] = True
                state["inventory"].append("Бронежилет")
                print("Ви купили бронежилет.")
            else:
                print("Недостатньо грошей.")
        elif choice == "3":
            break
        else:
            print("Невірний вибір.")

    # Мінібос
    enemy_hp = 70
    print("""
===========================
   ВОГНЯНИЙ СТРАЖ
===========================
""")
    while enemy_hp > 0 and state["hp"] > 0:
        print("\nВаш HP:", state["hp"])
        print("HP Стража:", enemy_hp)
        print("""
1. Атакувати
2. Ухилитися
""")
        move = input("Ваш вибір: ")

        if move == "1":
            enemy_hp -= state["attack"]
            print(f"Ви завдали {state['attack']} шкоди.")
        elif move == "2":
            print("Ви ухиляєтесь.")
        else:
            print("Невірний вибір.")
            continue

        if enemy_hp <= 0:
            break

        enemy_damage = 20
        if move == "2":
            enemy_damage = 10
            print("Ви зменшили отриману шкоду.")
        state["hp"] -= enemy_damage
        print(f"Страж завдав {enemy_damage} шкоди.")

    if state["hp"] <= 0:
        print("""
===========================
        ПОРАЗКА
===========================
""")
        return

    print("""
===========================
      СТРАЖ ПЕРЕМОЖЕНИЙ
===========================
""")
    state["money"] += 20
    print("+20 монет")
    state["volcano_complete"] = True
    print("Попереду знаходиться храм.")

# ===========================================
# FINAL BOSS
# ===========================================

def final_boss(state):
    boss_hp = 180
    boss_attack = 25

    print("""
===========================
       ФІНАЛЬНИЙ БОС
===========================
""")
    print("Перед вами Володар Храму!")

    while state["hp"] > 0 and boss_hp > 0:
        print("\nВаш HP:", state["hp"])
        print("HP Боса:", boss_hp)
        print("""
1. Атакувати
2. Ухилитися
3. Використати предмет
4. Інвентар
""")
        choice = input("Ваш вибір: ")

        if choice == "1":
            boss_hp -= state["attack"]
            print(f"Ви завдали {state['attack']} шкоди.")
        elif choice == "2":
            print("Ви готуєтесь ухилятися.")
        elif choice == "3":
            if len(state["inventory"]) == 0:
                print("Інвентар порожній.")
                continue
            print("\nПредмети:")
            for item in state["inventory"]:
                print("-", item)
            item = input("Що використати?: ").strip().lower().capitalize()
            if item == "Бинт" and "Бинт" in state["inventory"]:
                state["inventory"].remove("Бинт")
                state["hp"] += 25
                print("+25 HP")
            elif item == "Ягоди" and "Ягоди" in state["inventory"]:
                state["inventory"].remove("Ягоди")
                state["hp"] += 10
                print("+10 HP")
            elif item == "Вода" and "Вода" in state["inventory"]:
                state["inventory"].remove("Вода")
                state["hp"] += 15
                print("+15 HP")
            else:
                print("Цей предмет не можна використати.")
                continue
        elif choice == "4":
            print("\nІНВЕНТАР:")
            for item in state["inventory"]:
                print("-", item)
            continue
        else:
            print("Невірний вибір.")
            continue

        if boss_hp <= 0:
            break

        damage = boss_attack
        if choice == "2":
            damage = boss_attack // 2
            print("Ви ухилилися частково.")
        elif choice == "3":
            damage = boss_attack // 2
            print("Використовуючи предмет, ви частково ухилилися від удару.")

        if state["armor"]:
            damage -= 5
            damage = max(damage, 0)

        state["hp"] -= damage
        print(f"Бос завдав {damage} шкоди.")

    if state["hp"] <= 0:
        print("""
===========================
        ВИ ПРОГРАЛИ
===========================
""")
        return False

    print("""
===========================
        ПЕРЕМОГА!
===========================
""")
    state["money"] += 50
    print("+50 монет")
    return True

